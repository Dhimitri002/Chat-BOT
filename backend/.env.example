# ============================================================
# Flora Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# ─── Application ───────────────────────────────────────────
APP_NAME=Flora Platform
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
APP_SECRET_KEY=change-me-use-openssl-rand-hex-32
APP_ALLOWED_HOSTS=*

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./flora.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://flora:password@localhost:5432/flora

# ─── Security ─────────────────────────────────────────────
JWT_SECRET=change-me-jwt-secret-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
ENCRYPTION_KEY=change-me-encryption-key-fernet-compatible

# ─── Admin ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@flora.local
ADMIN_PASSWORD=change-me-strong-password
ADMIN_NAME=Flora Admin

# ─── LLM Provider API Keys ─────────────────────────────────
# At least one provider API key is required.
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=your-google-ai-gemini-key
GROQ_API_KEY=gsk-your-groq-key
MISTRAL_API_KEY=your-mistral-key
COHERE_API_KEY=your-cohere-key

# Ollama (local — no API key needed)
OLLAMA_BASE_URL=http://localhost:11434

# ─── LLM Defaults ─────────────────────────────────────────
LLM_DEFAULT_PROVIDER=openai
LLM_DEFAULT_MODEL=gpt-4o-mini
LLM_FALLBACK_PROVIDER=openai
LLM_FALLBACK_MODEL=gpt-3.5-turbo
LLM_MAX_RETRIES=3
LLM_REQUEST_TIMEOUT_SECONDS=60

# ─── WhatsApp Connector ────────────────────────────────────
WHATSAPP_CONNECTOR_URL=http://localhost:3333
WHATSAPP_CONNECTOR_KEY=

# ─── Redis (optional — for caching / rate limiting) ────────
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

# ─── File Storage ──────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/flora.log

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8200,http://127.0.0.1:8200

# ─── License / Licensing ───────────────────────────────────
LICENSE_PRIVATE_KEY=
LICENSE_PUBLIC_KEY=

# ─── Email (optional — for notifications) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@flora.local
SMTP_FROM_NAME=Flora Platform

# ─── Billing / Payments (optional) ────────────────────────
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_STARTER=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_BUSINESS=
STRIPE_PRICE_ID_ENTERPRISE=
