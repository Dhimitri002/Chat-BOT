# ═══════════════════════════════════════════════════════════════
# Flora Platform — Git Ignore
# ═══════════════════════════════════════════════════════════════

# ─── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.eggs/
*.whl

# ─── Virtual Environments ──────────────────────────────────
venv/
.venv/
env/
.env/

# ─── IDE ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Environment Files ─────────────────────────────────────
.env
.env.local
.env.production
.env.*.local

# ─── Database ──────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── OS ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Logs ──────────────────────────────────────────────────
*.log
logs/

# ─── Testing ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.tox/

# ─── Node (WhatsApp connector) ─────────────────────────────
node_modules/
package-lock.json
yarn.lock

# ─── App Data ──────────────────────────────────────────────
apps/admin/data/
apps/client/data/
data/

# ─── Docker ─────────────────────────────────────────────────
docker-compose.override.yml

# ─── Temporary ─────────────────────────────────────────────
tmp/
temp/
*.tmp
