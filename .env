# ═══════════════════════════════════════════════════════════════
# Flora Platform — Environment Variables Example
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Application ───────────────────────────────────────────
APP_NAME=Flora Platform
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000

# ─── Security Keys (REQUIRED — change in production!) ──────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
FLORA_MASTER_KEY=flora-master-key-change-in-production-min-32-chars
LICENSE_SIGNING_KEY=license-signing-key-change-in-production-32-chars

# ─── AES-256 Encryption ────────────────────────────────────
ENCRYPTION_MASTER_KEY=your-encryption-key-32-bytes-long!!
ENCRYPTION_KEY_VERSION=1
LICENSE_ENCRYPTION_KEY=flora-license-encryption-key!!

# ─── Database ──────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./flora.db
# For PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/flora

# ─── JWT ───────────────────────────────────────────────────
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── License Settings ──────────────────────────────────────
LICENSE_GRACE_PERIOD_DAYS=7
LICENSE_MAX_MACHINES=1
LICENSE_MAX_TRANSFERS=3

# ─── Session / Token ───────────────────────────────────────
SESSION_TIMEOUT_MINUTES=60
TOKEN_BLACKLIST_ENABLED=true
TOTP_ISSUER=Flora Platform

# ─── Argon2 / Password Hashing ─────────────────────────────
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=4
PASSWORD_MIN_LENGTH=8

# ─── LLM Providers ─────────────────────────────────────────
LLM_PROVIDER=groq
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
GOOGLE_API_KEY=...
MISTRAL_API_KEY=...
COHERE_API_KEY=...
OLLAMA_BASE_URL=http://localhost:11434

# ─── Admin ─────────────────────────────────────────────────
ADMIN_EMAIL=admin@flora.local
ADMIN_PASSWORD=change-me-in-production

# ─── WhatsApp ──────────────────────────────────────────────
WHATSAPP_CONNECTOR_URL=http://localhost:3000

# ─── Redis (optional) ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000","http://localhost:5173"]

# ─── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/flora.log
