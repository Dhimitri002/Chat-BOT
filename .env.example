# =============================================
# Flora Platform — Environment Variables Template
# Copie para .env e preencha com valores REAIS E SEGUROS
# GERE CHAVES COM: python -c "import secrets; print(secrets.token_hex(32))"
# =============================================

# Database
DATABASE_URL=sqlite:///./data/flora.db

# Security — 🔴 OBRIGATÓRIO (gere valores únicos)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-use-secrets-token-hex-32-MUST_BE_UNIQUE
FLORA_MASTER_KEY=change-me-use-secrets-token-hex-32-MUST_BE_UNIQUE
LICENSE_SIGNING_KEY=change-me-use-secrets-token-hex-64-MUST_BE_UNIQUE

# JWT
ALGORITHM=RS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# App
APP_NAME=Flora Platform
APP_VERSION=0.1.0
DEBUG=True

# CORS — separado por vírgula em produção
CORS_ORIGINS=["http://localhost:8000","http://localhost:3000"]

# LLM API Keys
GROQ_API_KEY=gsk_sua_key_aqui
GEMINI_API_KEY=AIza_sua_key_aqui
OPENAI_API_KEY=sk_sua_key_aqui
ANTHROPIC_API_KEY=sk-ant_sua_key_aqui

# Redis (opcional — para cache e rate limiting)
REDIS_URL=redis://localhost:6379/0

# Stripe (opcional — para billing)
STRIPE_SECRET_KEY=sk_test_sua_key_aqui
STRIPE_WEBHOOK_SECRET=whsec_sua_key_aqui

# Mercado Pago (opcional — para billing)
MP_ACCESS_TOKEN=seu_token_aqui

# Email SMTP (opcional — para notificações)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@gmail.com
SMTP_PASSWORD=sua_senha_app

# WhatsApp Connector
WHATSAPP_CONNECTOR_URL=http://localhost:3333
