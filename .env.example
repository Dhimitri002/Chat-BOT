# 🌸 Flora Platform — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores

# =============================================
# APLICAÇÃO
# =============================================
APP_NAME=Flora Platform
APP_VERSION=1.0.0
APP_URL=http://localhost:8000
APP_URL_CLIENT=http://localhost:8001
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
ENCRYPTION_KEY=your-32-byte-encryption-key-here

# =============================================
# BANCO DE DADOS
# =============================================
# Desenvolvimento (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./flora.db

# Produção (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://flora:flora@localhost:5432/flora_platform

# =============================================
# REDIS
# =============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# =============================================
# JWT / AUTENTICAÇÃO
# =============================================
JWT_SECRET=your-jwt-secret-min-32-chars-long!!
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
TOKEN_ISSUER=flora-platform

# =============================================
# ADMIN
# =============================================
ADMIN_EMAIL=admin@flora.com
ADMIN_PASSWORD=Admin@123456
ADMIN_NAME=Administrador

# =============================================
# WHATSAPP
# =============================================
WHATSAPP_SESSION_PATH=./whatsapp_sessions
WHATSAPP_MAX_RETRIES=5
WHATSAPP_RETRY_DELAY=5
WHATSAPP_WEBHOOK_URL=https://your-domain.com/api/v1/webhooks/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# =============================================
# FLORA AI / LLM
# =============================================
# OpenAI
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=anthropic-your-key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google AI (Gemini)
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-1.5-flash

# OpenRouter (multi-provider)
OPENROUTER_API_KEY=or-your-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openrouter/auto

# LLM Router Configuration
LLM_ROUTER_STRATEGY=cost_optimized
LLM_ROUTER_FALLBACK=true
LLM_DEFAULT_PROVIDER=openrouter
LLM_CACHE_TTL=3600

# Flora AI Model (per plan)
FLORA_MODEL_FREE=openrouter/auto
FLORA_MODEL_STARTER=openrouter/auto
FLORA_MODEL_BASIC=gpt-4o-mini
FLORA_MODEL_PRO=gpt-4o
FLORA_MODEL_PREMIUM=claude-sonnet-4-20250514
FLORA_MODEL_BUSINESS=claude-opus-4
FLORA_MODEL_ENTERPRISE=claude-opus-4

# =============================================
# LICENCIAS
# =============================================
LICENSE_SIGNING_KEY=your-license-signing-key-32-bytes!!
LICENSE_HARDWARE_BINDING=true
LICENSE_GRACE_PERIOD_HOURS=24
LICENSE_CHECK_INTERVAL_SECONDS=3600

# =============================================
# PAGAMENTOS (Stripe)
# =============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_CURRENCY=brl

# =============================================
# NOTIFICAÇÕES
# =============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Flora Platform <noreply@flora.com>

# =============================================
# LOGGING & MONITORAMENTO
# =============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/flora.log
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_API=60/minute
RATE_LIMIT_WHATSAPP=30/minute
